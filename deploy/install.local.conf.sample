# LIDALDI installer local configuration (T10, arch doc §6.5).
#
# Copy to `install.local.conf` next to update.sh and edit. The real file is
# git-ignored: paths differ per environment and never belong in the repo.
# Sourced by bash — KEY="value" lines only, no command substitution.

# Where the application code + live config.toml/.env live.
APP_ROOT="/opt/lidaldi"

# Web root served by nginx (frontend/dist build output; offers.json and
# meta.json are written here by process_offers.py — the installer never
# rewrites their content, it only sets their owner/mode).
WEB_ROOT="/var/www/lidaldi"

# Group nginx runs as. Web root policy (enforced on every run): everything
# root:WEB_GROUP, dirs 0750, files 0640; SERVICE_USER owns the web root dir,
# offers.json/meta.json and the IMAGES_DIR tree, and must be a member of
# WEB_GROUP (added automatically when MANAGE_USER=1).
#WEB_GROUP="www-data"

# Where the scraper stores product images (must be inside WEB_ROOT; nginx
# serves it). Also the directory the daily 90-day image cleanup prunes.
#IMAGES_DIR="/var/www/lidaldi/img/full"

# npm used to rebuild frontend/dist when the frontend sources changed.
#NPM_BIN="npm"

# System user the cron job and sync service run as (created if missing).
SERVICE_USER="lidaldi"

# Sync profile store (alerts, lastVisit, push subscriptions). Backed up
# before every mutating update.
SYNC_DIR="/opt/lidaldi/data/sync"

# Log directory (cron output, logrotate target).
LOG_DIR="/var/log/lidaldi"

# Optional: Prometheus node_exporter textfile collector directory.
# Uncomment to grant the sync service write access to it.
#PROM_DIR="/var/lib/prometheus/node-exporter"

# Python runtime. update.sh expects pyenv + pyenv-virtualenv and creates/reuses
# /opt/pyenv/versions/lidaldi from a pinned Python 3.12.x by default.
#PYENV_ROOT="/opt/pyenv"
#PYENV_PYTHON_VERSION="3.12.13"
#PYENV_VIRTUALENV_NAME="lidaldi"

# Where timestamped pre-update backups (configs + SYNC_DIR) are written.
#BACKUP_DIR="/var/backups/lidaldi"

# --- Rarely needed overrides (defaults shown) --------------------------------
# Source checkout the installer deploys from (defaults to the repo containing
# update.sh).
#REPO_DIR="/opt/lidaldi-checkout"
#CRON_DIR="/etc/cron.d"
#LOGROTATE_DIR="/etc/logrotate.d"
#SYSTEMD_DIR="/etc/systemd/system"
#NGINX_SNIPPET_DIR="/etc/nginx/snippets"
# Set to 0 to skip service-user management (e.g. containers/tests).
#MANAGE_USER=1
