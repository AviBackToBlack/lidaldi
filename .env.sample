# LIDALDI secrets (T9). Copy to `.env` next to your config.toml and edit.
# NEVER commit the real .env. Non-secret configuration lives in config.toml.
# Process environment variables override values set here.

# Telegram operator alerts (bot token + destination chat).
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_CHAT_ID=your-chat-id

# Path to the VAPID private key PEM (long-lived Web Push signing credential).
# Generate with:  PYENV_VERSION=lidaldi python generate_vapid_keys.py /path/to/processing/folder
# then lock it down:
#     chown lidaldi:lidaldi vapid_private.pem
#     chmod 600 vapid_private.pem
# Defaults to <offers_processing_dir>/vapid_private.pem when unset.
#VAPID_PRIVATE_KEY_PATH=/path/to/processing/folder/vapid_private.pem
